#!/usr/bin/env python3
"""Generate each host's skills from the shared templates.

    ./setup --host antigravity      regenerate hosts/antigravity/skills/
    ./setup                         regenerate every host in fragments/
    ./setup --check                 fail if any committed output is stale

Templates live in skills/<name>/SKILL.md.tmpl. Each {{PLACEHOLDER}} is filled
from fragments/<host>/:

  simple.vars          KEY=VALUE lines for one-line values
  <PLACEHOLDER>.md     a whole block; the line holding the placeholder is
                       replaced by the file's contents

A placeholder with no value is an error, so a typo cannot silently drop text.
To leave a placeholder empty for a host, add an empty <PLACEHOLDER>.md.

--check also verifies that hosts/<host>/LICENSE matches the root LICENSE.
"""

import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SKILLS = ROOT / "skills"
FRAGMENTS = ROOT / "fragments"
HOSTS = ROOT / "hosts"
PLACEHOLDER = re.compile(r"\{\{([A-Z][A-Z0-9_]*)\}\}")


def load_vars(host_dir: Path) -> dict:
    values = {}
    path = host_dir / "simple.vars"
    if path.exists():
        for line in path.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            key, sep, value = line.partition("=")
            if not sep:
                sys.exit(f"{path}: expected KEY=VALUE, got {line!r}")
            values[key.strip()] = value
    return values


def render(template: Path, host: str) -> str:
    host_dir = FRAGMENTS / host
    values = load_vars(host_dir)
    out = []
    for line in template.read_text().splitlines(keepends=True):
        names = PLACEHOLDER.findall(line)
        block = [n for n in names if (host_dir / f"{n}.md").exists()]
        if block:
            if line.strip() != "{{%s}}" % block[0]:
                sys.exit(f"{template}: block placeholder {{{{{block[0]}}}}} must be alone on its line")
            out.append((host_dir / f"{block[0]}.md").read_text())
            continue
        for name in names:
            if name not in values:
                sys.exit(f"{template}: no value for {{{{{name}}}}} in {host_dir.relative_to(ROOT)}")
        out.append(PLACEHOLDER.sub(lambda m: values[m.group(1)], line))
    text = "".join(out)

    # Mark the file as generated, after the frontmatter so parsers still see
    # "---" on line 1.
    note = (
        f"<!-- Generated from {template.relative_to(ROOT)} and "
        f"fragments/{host}/ by ./setup. Do not edit by hand. -->\n"
    )
    head, sep, body = text.partition("\n---\n")
    if not text.startswith("---\n") or not sep:
        sys.exit(f"{template}: expected YAML frontmatter")
    return f"{head}\n---\n\n{note}{body}"


def outputs(host: str):
    for template in sorted(SKILLS.glob("*/SKILL.md.tmpl")):
        name = template.parent.name
        yield HOSTS / host / "skills" / name / "SKILL.md", render(template, host)


def main() -> int:
    hosts = sorted(p.name for p in FRAGMENTS.iterdir() if p.is_dir())
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--host", choices=hosts, help="one host (default: all)")
    parser.add_argument("--check", action="store_true", help="only report stale files")
    args = parser.parse_args()

    stale = []
    for host in [args.host] if args.host else hosts:
        for path, text in outputs(host):
            if path.exists() and path.read_text() == text:
                continue
            if args.check:
                stale.append(path)
            else:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(text)
                print(f"wrote {path.relative_to(ROOT)}")
        if args.check:
            license_copy = HOSTS / host / "LICENSE"
            if not license_copy.exists() or license_copy.read_bytes() != (ROOT / "LICENSE").read_bytes():
                stale.append(license_copy)

    for path in stale:
        print(f"stale: {path.relative_to(ROOT)}", file=sys.stderr)
    if stale:
        print("Run ./setup and commit the result (copy LICENSE into each host).", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
